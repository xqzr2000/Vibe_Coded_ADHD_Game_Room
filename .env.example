# ---------------------------------------------------------------------------
# Focus Room configuration
#
# NOTHING HERE IS REQUIRED. You can start the app with no keys at all and set
# a provider, model, and key from the web UI's settings panel (⚙ in the header).
# Values here act as the server-side default for anyone who hasn't set their own.
# ---------------------------------------------------------------------------

# Default/fallback keys. Add whichever you have.
OPENROUTER_API_KEY=          # https://openrouter.ai/keys
GROQ_API_KEY=                # https://console.groq.com/keys
GEMINI_API_KEY=              # https://aistudio.google.com/apikey
CUSTOM_API_KEY=              # any OpenAI-compatible endpoint
CUSTOM_BASE_URL=             # e.g. http://localhost:11434/v1

# Optional gateway/proxy overrides for built-in providers.
OPENROUTER_BASE_URL=
GROQ_BASE_URL=
GEMINI_BASE_URL=

PORT=3000

# --- Deep search (optional browser-use sidecar) ---
# Start it with: npm run browser   (after: npm run setup:browser)
BROWSER_SERVICE_URL=http://127.0.0.1:8010
BROWSER_MODEL=openrouter/free
BROWSER_MAX_STEPS=12
BROWSER_LLM_TIMEOUT=60
BROWSER_STEP_TIMEOUT=90
BROWSER_TIMEOUT_MS=240000
