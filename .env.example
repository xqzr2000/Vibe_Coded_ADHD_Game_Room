# ---------------------------------------------------------------------------
# Focus Room configuration — copy to .env and fill in what you need.
#
# NOTHING HERE IS REQUIRED. With an empty .env, each browser pastes its own
# Groq key (and optionally a Tavily key) in the app.
# ---------------------------------------------------------------------------

# Groq — free key from https://console.groq.com/keys (starts with gsk_)
GROQ_API_KEY=

# Tavily — free key from https://app.tavily.com (starts with tvly-).
# Optional: without it Scout searches DuckDuckGo instead.
TAVILY_API_KEY=

# Should browser sessions use the keys above?
#   0 (default) — no. Every visitor must paste their own key. Use this for
#                 anything reachable by other people (a shared Codespace URL,
#                 a public port).
#   1           — yes. On your own private machine this means you never have
#                 to paste a key into the browser.
ALLOW_SERVER_KEYS=0

# Long-term memory: session summaries saved in data/memories.json.
# Set to 0 to keep nothing between sessions.
LOCAL_MEMORY=1

PORT=3000

# Where the server listens. Default: 127.0.0.1 (this machine only) on a plain
# Ubuntu box, 0.0.0.0 inside a dev container / Codespace.
# Set HOST=0.0.0.0 to reach it from other devices on your network.
# HOST=127.0.0.1

# Optional: override the free-model allowlist when Groq changes its Free plan.
# Must be models listed under Free plan at https://console.groq.com/docs/rate-limits
# GROQ_FREE_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
