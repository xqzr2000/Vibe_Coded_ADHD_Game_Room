# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the model each agent uses (any OpenRouter model id)
DOCTOR_MODEL=anthropic/claude-sonnet-4
RESEARCHER_MODEL=openai/gpt-4o-mini

PORT=3000

# --- Deep search (optional browser-use sidecar) ---
# Start it with: npm run browser   (after: npm run setup:browser)
BROWSER_SERVICE_URL=http://127.0.0.1:8010
BROWSER_MODEL=openai/gpt-4o-mini
BROWSER_MAX_STEPS=20
BROWSER_TIMEOUT_MS=240000
