# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter free-model router
DOCTOR_MODEL=openrouter/free
RESEARCHER_MODEL=openrouter/free

PORT=3000

# --- Deep search (optional browser-use sidecar) ---
# Start it with: npm run browser   (after: npm run setup:browser)
BROWSER_SERVICE_URL=http://127.0.0.1:8010
BROWSER_MODEL=openrouter/free
BROWSER_MAX_STEPS=10
BROWSER_TIMEOUT_MS=180000
